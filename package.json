{
  "name": "monolito-v2",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "bin": {
    "monolito": "./bin/monolito.js"
  },
  "scripts": {
    "daemon": "node --experimental-strip-types src/apps/daemon.ts",
    "cli": "node --experimental-strip-types src/apps/cli.ts",
    "mcp:demo": "node --experimental-strip-types src/core/mcp/devServer.ts",
    "build": "tsc --noEmit",
    "check": "node bin/monolito.js --help",
    "test": "node --experimental-strip-types --test $(find src -name '*.test.ts')",
    "test:guards": "node --experimental-strip-types --test src/core/runtime/veracityGuard.test.ts src/core/runtime/coherenceGuard.test.ts src/core/runtime/test_react_guards.test.ts src/core/runtime/test_semantic_recovery.test.ts src/core/runtime/test_multiverse.test.ts src/core/runtime/delegationGate.test.ts src/core/runtime/orchestratorResilience.test.ts src/core/runtime/topLevelRalphGate.test.ts",
    "test:tools": "node --experimental-strip-types --test src/core/tools/registry.test.ts src/core/tools/permissions.test.ts src/core/tools/toolInput.test.ts src/core/tools/test_list_model_tools_regression.test.ts src/apps/cli/test_self_heal.test.ts src/core/config/wingValue.test.ts src/core/logging/logger.test.ts src/core/websearch/test_search_providers.test.ts",
    "test:runtime": "node --experimental-strip-types --test src/core/runtime/test_runtime_integration.test.ts src/core/runtime/test_orchestrator_smoke.test.ts src/core/runtime/test_inactivity_consolidation.test.ts src/core/runtime/test_bootstrap_config.test.ts src/core/runtime/subAgentRenewal.test.ts src/core/session/test_store_helpers.test.ts src/core/session/test_query_semantic_tools_regression.test.ts",
    "test:ci": "node --experimental-strip-types --test $(find src -name '*.test.ts')"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.91.1",
    "shell-quote": "^1.8.4",
    "zod": "^4.4.1"
  },
  "devDependencies": {
    "@types/node": "^22.15.0",
    "typescript": "^6.0.2"
  }
}
