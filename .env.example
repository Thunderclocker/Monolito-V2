# =============================================================================
# Monolito V2 — Environment Variables
# =============================================================================
# Copy this file to ~/.monolito/.env (production) or to the project root as
# .env (local dev) and fill in the values that apply. The runtime loads this
# file at startup via src/core/system/root.ts (loadEnvFile).
#
# Layout rule of thumb:
#   - Production: ~/.monolito/.env   (sourced by the systemd service)
#   - Local dev:  ./Monolito V2/.env  (loaded by `node --experimental-strip-types`)
#
# Anything you can configure here can also be set with the in-app menu
# (`/model`, `/channels`, `/websearch`) and is then persisted into SQLite
# CONF_* wings. The .env file is the bootstrap source; the SQLite wings are
# the runtime source of truth.
# =============================================================================


# -----------------------------------------------------------------------------
# Runtime layout
# -----------------------------------------------------------------------------

# Root directory for runtime state. Defaults to ~/.monolito when unset.
# Production install.sh writes state under ~/.monolito/{memory,logs,run,
# profiles,scratchpad,grok_oauth.json,...}.
# Set this to override (e.g. MONOLITO_ROOT=/srv/monolito).
# MONOLITO_ROOT=~/.monolito

# Operational mode. Affects log levels, the systemd unit, and how
# MONOLITO_ROOT is resolved. Set by install.sh to "production" on the
# systemd unit. Local dev should leave it empty.
# MONOLITO_MODE=production

# Set by install.sh; forces the daemon to bind to the production paths.
# NODE_ENV=production


# -----------------------------------------------------------------------------
# Model provider
# -----------------------------------------------------------------------------
# These four are the only fields strictly required at first launch. Everything
# else can be configured through `/model` once the daemon is alive.

# Base URL of the Anthropic-compatible endpoint. The runtime strips any
# trailing /v1/messages before calling the SDK. Examples:
#   https://api.anthropic.com
#   https://api.minimax.io/v1
#   http://127.0.0.1:11434  (when using a local Anthropic-protocol proxy)
# ANTHROPIC_BASE_URL=

# Auth token for the provider above. Can be a real API key or any non-empty
# string when the endpoint ignores auth (e.g. local proxies).
# ANTHROPIC_AUTH_TOKEN=

# Default model id used on the active profile. Examples:
#   claude-opus-4-8
#   MiniMax-M2.7
#   grok-2-latest
#   qwen2.5-coder:14b
# ANTHROPIC_MODEL=

# Provider key resolved by the runtime when MONOLITO_MODE is unset.
# Values: anthropic_compatible | minimax | openai_compatible | ollama | xai
# For xai-oauth, configure via `monolito auth xai-oauth` and pick the
# `xai-oauth` profile in `/model`.
# MONOLITO_ACTIVE_PROVIDER=anthropic_compatible

# API key para generación de imágenes con MiniMax (modelo `image-01`).
# Opcional: si ya tenés un perfil MiniMax activo en `/model`, su `apiKey`
# se reusa automáticamente para `GenerateImage`. Si no, también se acepta
# `ANTHROPIC_AUTH_TOKEN` como fallback (la misma key del endpoint
# Anthropic-compatible de chat).
# MINIMAX_API_KEY=


# -----------------------------------------------------------------------------
# Model runtime behavior
# -----------------------------------------------------------------------------

# Hard timeout for any single model API call, in milliseconds. The runtime
# also enforces internal per-turn timeouts (TURN_HARD_TIMEOUT_MS=95s) and
# subagent timeouts (15 min hard, 10 min soft). Default: 3000000 (50 min).
# API_TIMEOUT_MS=3000000


# -----------------------------------------------------------------------------
# Embeddings (removed)
# -----------------------------------------------------------------------------
# Monolito V2 no longer uses Ollama embeddings, vec_drawers, or SQLite memory.
# Recall is keyword-based over memory.md and session JSONL.
